# Database Configuration (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/medsync?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medsync
DB_USER=neondb_owner
DB_PASSWORD=secret
PORT=8000
ENVIRONMENT=development

# Authentication & JWT Configuration
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# HttpOnly Cookie Security Configuration
COOKIE_NAME=medsync_access_token
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# CSRF Protection
CSRF_SECRET_KEY=change_this_to_a_secure_csrf_key_in_production

# Frontend URLs for Credentialed CORS
FRONTEND_URLS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000